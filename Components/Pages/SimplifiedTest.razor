@page "/simplified-test"
@inject IJSRuntime JSRuntime

<h3>Simplified Button Test</h3>

<div style="padding: 20px; background: #fff; border: 1px solid #ccc;">
    <button @onclick="TestClick" style="pointer-events:auto; padding: 10px 20px; background: #007bff; color: white; border: none; border-radius: 5px;">
        Test Click
    </button>
    
    <p>Click count: @clickCount</p>
</div>

@code {
    private int clickCount = 0;
    
    private async Task TestClick()
    {
        clickCount++;
        Console.WriteLine($"Button clicked! Count: {clickCount}");
        await JSRuntime.InvokeVoidAsync("alert", $"Button clicked! Count: {clickCount}");
        StateHasChanged();
    }
}
