@page "/button-test"
@inject IJSRuntime JSRuntime

<h3>Button Test Page</h3>

<div style="padding: 20px; background: #f0f0f0; margin: 20px 0;">
    <h4>Simple Button Tests</h4>
    
    <button class="btn btn-primary" @onclick="SimpleClick">Simple Click Test</button>
    <br/><br/>
    
    <button class="btn btn-secondary" @onclick="ParameterClickHandler">Parameter Click Test</button>
    <br/><br/>
    
    <div>
        @foreach (var mode in TestModes)
        {
            var currentMode = mode;
            <button class="btn btn-outline-primary me-2" @onclick="() => ModeClick(currentMode)">
                @currentMode
            </button>
        }
    </div>
    
    <div style="margin-top: 20px;">
        <strong>Selected Mode:</strong> @SelectedMode
    </div>
</div>

@code {
    private string SelectedMode { get; set; } = "None";
    private List<string> TestModes = new() { "Restaurant", "Takeaway", "Buffet" };
      private async Task SimpleClick()
    {
        Console.WriteLine("Simple click worked!");
        await JSRuntime.InvokeVoidAsync("alert", "Simple click worked!");
        SelectedMode = "Simple";
        StateHasChanged();
    }
    
    private async Task ParameterClickHandler()
    {
        await ParameterClick("test-mode");
    }
    
    private async Task ParameterClick(string mode)
    {
        Console.WriteLine($"Parameter click worked with: {mode}");
        await JSRuntime.InvokeVoidAsync("alert", $"Parameter click worked: {mode}");
        SelectedMode = mode;
        StateHasChanged();
    }
    
    private async Task ModeClick(string mode)
    {
        Console.WriteLine($"Mode click worked with: {mode}");
        await JSRuntime.InvokeVoidAsync("alert", $"Mode click worked: {mode}");
        SelectedMode = mode;
        StateHasChanged();
    }
}
