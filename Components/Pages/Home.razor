@page "/"
@using Application.DTOs
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>FlexyBox - Restaurants</PageTitle>

<div class="container">
    <h1>Restaurants</h1>

    @if (restaurants == null)
    {
        <p>Loading...</p>
    }
    else if (!restaurants.Any())
    {
        <p>No restaurants found.</p>
    }
    else
    {
        <div class="restaurant-list">
            @foreach (var restaurant in restaurants)
            {
                <a href="/restaurant/@restaurant.Id" class="restaurant-card">
                    <div class="card-content">
                        <div class="restaurant-info">
                            <div class="restaurant-name-with-rating">
                                <h2>@restaurant.Name</h2>
                                <StarRating Rating="@restaurant.AverageRating" 
                                           ReviewCount="@restaurant.ReviewCount" 
                                           ShowText="true" 
                                           Size="small" />
                            </div>
                            <p class="address">@restaurant.Address</p>
                            <span class="status @(restaurant.IsOpen ? "open" : "closed")">
                                • @(restaurant.IsOpen ? "Open" : "Closed")
                            </span>
                        </div>
                        @if (restaurant.GalleryImages != null && restaurant.GalleryImages.Any())
                        {
                            <div class="restaurant-image">
                                <img src="@restaurant.GalleryImages.First()" 
                                     alt="@restaurant.Name" 
                                     loading="lazy" />
                            </div>
                        }
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<ResturantDto>? restaurants;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            restaurants = await Http.GetFromJsonAsync<List<ResturantDto>>("api/restaurant");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading restaurants: {ex.Message}");
            restaurants = new List<ResturantDto>();
        }
    }
}