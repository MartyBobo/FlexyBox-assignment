@page "/restaurant/{Id:int}"
@rendermode InteractiveServer
@using Application.DTOs
@using FlexyBox.Services
@inject IRestaurantService RestaurantService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="restaurant-detail">
    @if (Restaurant == null)
    {
        <div>Loading...</div>
    }
    else
    {
        <div class="restaurant-header">
            <div class="restaurant-title">
                <h1>@Restaurant.Name</h1>
                <div class="restaurant-status @(Restaurant.IsOpen ? "open" : "closed")">
                    • @(Restaurant.IsOpen ? "Open" : "Closed")
                </div>
                <div class="restaurant-address">
                    <span>@Restaurant.Address</span>
                </div>
            </div>            <div class="restaurant-favorite">
                <button class="icon-button favorite-button @(IsFavorited ? "favorited" : "") @(IsPulsing ? "pulse" : "")" 
                        @onclick="OnToggleFavorite"
                        disabled="@IsToggling">
                    @if (IsToggling)
                    {
                        <div class="spinner"></div>
                    }
                    else
                    {
                        <img src="@FavoriteIcon" alt="Favorite" class="heart-icon" />
                    }
                </button>
            </div>
        </div>        <div class="restaurant-contact">
            <div class="contact-item">
                <img src="/images/icons/phone-icon.svg" alt="Phone" class="icon" />
                <span>@Restaurant.Phone</span>
            </div>
            <div class="contact-item">
                <img src="/images/icons/email-icon.svg" alt="Email" class="icon" />
                <span>@Restaurant.Email</span>
            </div>
        </div>        <div class="gallery-container">
            @if (Restaurant.GalleryImages != null && Restaurant.GalleryImages.Any())
            {
                <div class="carousel">
                    <button class="carousel-btn carousel-prev" @onclick="PreviousImage" disabled="@(CurrentImageIndex == 0)">
                        <img src="/images/icons/arrow-left.svg" alt="Previous" />
                    </button>
                    
                    <div class="carousel-track-container">
                        <div class="carousel-track" style="transform: translateX(-@(CurrentImageIndex * 100)%)">
                            @for (int i = 0; i < Restaurant.GalleryImages.Count; i++)
                            {
                                var imageUrl = Restaurant.GalleryImages[i];
                                <div class="carousel-slide">
                                    <img src="@imageUrl" alt="Restaurant image @(i + 1)" />
                                </div>
                            }
                        </div>
                    </div>
                    
                    <button class="carousel-btn carousel-next" @onclick="NextImage" disabled="@(CurrentImageIndex >= Restaurant.GalleryImages.Count - 1)">
                        <img src="/images/icons/arrow-right.svg" alt="Next" />
                    </button>
                </div>
                
                <!-- Image indicators -->
                <div class="carousel-indicators">
                    @for (int i = 0; i < Restaurant.GalleryImages.Count; i++)
                    {
                        var index = i;
                        <button class="indicator @(CurrentImageIndex == index ? "active" : "")" 
                                @onclick="() => GoToImage(index)">
                        </button>
                    }
                </div>
            }
            else
            {
                <p>No images available.</p>
            }
        </div>

        <div class="opening-hours-section">
            <h2>Opening hours</h2>
            @if (Restaurant.OpeningHours != null && Restaurant.OpeningHours.Any())
            {                <div class="hours-filter">
                    @foreach (var mode in Restaurant.OpeningHours.Keys)
                    {
                        var isActive = SelectedMode == mode;
                        <button type="button"
                                class="hours-filter-button @(isActive ? "active" : "")"
                                @onclick="@(async () => await HandleModeSelection(mode))">
                            @mode
                        </button>
                    }
                </div>

                @if (!string.IsNullOrEmpty(SelectedMode) && Restaurant.OpeningHours.TryGetValue(SelectedMode, out var hoursForMode))
                {
                    <div class="hours-list">
                        <div class="status-message">Showing hours for: @SelectedMode</div>
                        @foreach (var entry in hoursForMode)
                        {
                            <div class="hours-item">
                                <span class="day-name">@entry.Day</span>
                                <span class="hours-time">@entry.Time</span>
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(SelectedMode))
                {
                    <div class="status-message">No opening hours found for @SelectedMode.</div>
                }
            }            else
            {
                <p>No opening hours available for this restaurant.</p>
            }
        </div>    }
</div>

@code {    [Parameter]
    public int Id { get; set; }    private ResturantDto? Restaurant { get; set; }
    private string? SelectedMode { get; set; }
    private bool IsFavorited { get; set; }
    private bool IsToggling { get; set; }
    private bool IsPulsing { get; set; }
    private int CurrentImageIndex { get; set; } = 0;
    
    private string FavoriteIcon => IsFavorited 
        ? "/images/icons/heart-filled.svg" 
        : "/images/icons/heart-icon.svg";

    protected override async Task OnInitializedAsync()
    {
        await LoadRestaurant();
    }    protected override async Task OnParametersSetAsync()
    {
        // This ensures data reloads if the Id parameter changes while on the same component instance
        if (Restaurant == null || Restaurant.Id != Id)
        {
            await LoadRestaurant();
        }
    }    private async Task LoadRestaurant()
    {
        try
        {
            Restaurant = await RestaurantService.GetRestaurantAsync(Id);            if (Restaurant == null)
            {
                NavigationManager.NavigateTo("/");
                return;
            }

            // Reset carousel to first image when loading new restaurant
            CurrentImageIndex = 0;

            // Load favorite status
            IsFavorited = await RestaurantService.IsFavoriteAsync(Id);

            if (Restaurant.OpeningHours != null && Restaurant.OpeningHours.Any())
            {
                // Set initial SelectedMode only if it's not already set or if the available modes changed
                var firstMode = Restaurant.OpeningHours.Keys.First();
                if (SelectedMode == null || !Restaurant.OpeningHours.ContainsKey(SelectedMode))
                {
                    SelectedMode = firstMode;
                }
            }
            else
            {
                SelectedMode = null;
            }
        }
        catch (Exception)
        {
            // Handle error appropriately - could set an error message property
        }
    }    private async Task HandleModeSelection(string mode)
    {
        SelectedMode = mode;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnToggleFavorite()
    {
        if (IsToggling) return;

        IsToggling = true;
        StateHasChanged();

        try
        {
            var wasToggled = await RestaurantService.ToggleFavoriteAsync(Id);
            IsFavorited = !IsFavorited; // Toggle the state
            
            // Trigger pulse animation
            IsPulsing = true;
            StateHasChanged();
              // Show feedback message
            var message = IsFavorited 
                ? $"{Restaurant?.Name} added to favorites!" 
                : $"{Restaurant?.Name} removed from favorites!";
            
            await JSRuntime.InvokeVoidAsync("showToast", message, "success");
            
            // Remove pulse animation after a short delay
            await Task.Delay(300);
            IsPulsing = false;
            StateHasChanged();
        }        catch (Exception ex)
        {
            // Handle error
            await JSRuntime.InvokeVoidAsync("showToast", "Error updating favorites. Please try again.", "error");
        }
        finally
        {
            IsToggling = false;
            StateHasChanged();
        }
    }

    private async Task NextImage()
    {
        if (Restaurant?.GalleryImages != null && CurrentImageIndex < Restaurant.GalleryImages.Count - 1)
        {
            CurrentImageIndex++;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PreviousImage()
    {
        if (CurrentImageIndex > 0)
        {
            CurrentImageIndex--;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GoToImage(int index)
    {
        if (Restaurant?.GalleryImages != null && index >= 0 && index < Restaurant.GalleryImages.Count)
        {
            CurrentImageIndex = index;
            await InvokeAsync(StateHasChanged);
        }
    }
}
