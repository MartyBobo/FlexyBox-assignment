@page "/restaurant-fixed/{Id:int}"
@using Application.Resturants.Queries
@using Application.DTOs
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="restaurant-detail">
    @if (Restaurant == null)
    {
        <div>Loading...</div>
    }
    else
    {
        <div class="restaurant-header">
            <div class="restaurant-title">
                <h1>@Restaurant.Name</h1>
                <div class="restaurant-status @(Restaurant.IsOpen ? "open" : "closed")">
                    • @(Restaurant.IsOpen ? "Open" : "Closed")
                </div>
                <div class="restaurant-address">
                    <span>@Restaurant.Address</span>
                </div>
            </div>
            <div class="restaurant-favorite">
                <button class="favorite-button">
                    <span class="oi oi-heart"></span>
                </button>
            </div>
        </div>

        <div class="restaurant-contact">
            <div class="contact-item">
                <i class="contact-icon oi oi-phone"></i>
                <span>@Restaurant.Phone</span>
            </div>
            <div class="contact-item">
                <i class="contact-icon oi oi-envelope-closed"></i>
                <span>@Restaurant.Email</span>
            </div>
        </div>

        <div class="gallery-container">
            <div class="gallery-scroller">                @if (Restaurant.GalleryImages != null)
                {
                    @foreach (var image in Restaurant.GalleryImages)
                    {
                        <div class="gallery-image">
                            <img src="@image" alt="Restaurant image" />
                        </div>
                    }
                }
            </div>
        </div>

        <div class="opening-hours-section">
            <h2>Opening hours</h2>
            
            <div class="debug-info" style="background: #f0f0f0; padding: 10px; margin: 10px 0; border-radius: 5px;">
                <div><strong>Debug Information:</strong></div>
                <div>Current mode: <strong>@SelectedMode</strong></div>
                <div>Available modes: <strong>@(Restaurant?.OpeningHours != null ? string.Join(", ", Restaurant.OpeningHours.Keys) : "None")</strong></div>
                <div>Total modes count: <strong>@(Restaurant?.OpeningHours?.Count ?? 0)</strong></div>
                <div>Restaurant loaded: <strong>@(Restaurant != null ? "Yes" : "No")</strong></div>
                <button class="btn btn-primary mt-2" @onclick="DebugButtonTest">Test Button Click</button>
            </div>
            
            <div class="hours-filter">
                @if (Restaurant?.OpeningHours != null)
                {
                    @foreach (var mode in Restaurant.OpeningHours.Keys)
                    {
                        var currentMode = mode;
                        <button type="button" 
                                class="hours-filter-button @(SelectedMode == currentMode ? "active" : "")" 
                                @onclick="@(async () => await SelectMode(currentMode))">
                            @currentMode
                        </button>
                    }
                }
            </div>
            
            @if (Restaurant?.OpeningHours != null && Restaurant.OpeningHours.TryGetValue(SelectedMode, out var hours))
            {
                <div class="hours-list">
                    <div class="status-message">Showing hours for: @SelectedMode</div>
                    @foreach (var hour in hours)
                    {
                        <div class="hours-item">
                            <span class="day-name">@hour.Day</span>
                            <span class="hours-time">@hour.Time</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="status-message error">No hours available for: @SelectedMode</div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ResturantDto? Restaurant { get; set; }
    private string SelectedMode { get; set; } = "Restaurant";

    protected override async Task OnInitializedAsync()
    {
        await LoadRestaurant();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadRestaurant();
    }

    private async Task LoadRestaurant()
    {
        var query = new GetResturantByIdQuery { Id = Id };
        Restaurant = await Mediator.Send(query);
        
        if (Restaurant == null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        // Set default selected mode if available
        if (Restaurant.OpeningHours.Any())
        {
            SelectedMode = Restaurant.OpeningHours.Keys.First();
        }
    }

    private async Task DebugButtonTest()
    {
        Console.WriteLine("Debug test button clicked!");
        await JSRuntime.InvokeVoidAsync("alert", "Debug button works!");
        StateHasChanged();
    }

    private async Task SelectMode(string mode)
    {
        // Log all information for debugging
        Console.WriteLine($"SelectMode called with mode: {mode}");
        Console.WriteLine($"Current SelectedMode: {SelectedMode}");
        
        try
        {
            // Show alert for debugging
            await JSRuntime.InvokeVoidAsync("alert", $"Button clicked: {mode}");
            
            // Check for nulls
            if (string.IsNullOrEmpty(mode))
            {
                Console.WriteLine("Error: Mode is null or empty");
                return;
            }

            if (Restaurant == null)
            {
                Console.WriteLine("Error: Restaurant is null");
                return;
            }
            
            if (Restaurant.OpeningHours == null)
            {
                Console.WriteLine("Error: OpeningHours dictionary is null");
                return;
            }
            
            Console.WriteLine($"Available modes: {string.Join(", ", Restaurant.OpeningHours.Keys)}");
            
            if (!Restaurant.OpeningHours.ContainsKey(mode))
            {
                Console.WriteLine($"Warning: Mode '{mode}' not found in OpeningHours dictionary");
                return;
            }
            
            // Update the selected mode
            var previousMode = SelectedMode;
            SelectedMode = mode;
            
            Console.WriteLine($"Mode changed from '{previousMode}' to '{SelectedMode}'");
            
            // Force UI update
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in SelectMode: {ex.Message}");
        }
    }
}
